# 複製為 llm.local.env，可在本機覆蓋 .env 的 LLM 設定。
DEEPSEEK_BASE_URL=http://127.0.0.1:9932/v1
# 伺服器未啟用 API 驗證時使用占位值。
DEEPSEEK_API_KEY=local-no-key
DEEPSEEK_MODEL=qwen-chat
# 為本機決策指定模型，覆蓋 .env 裡可能設定的雲端決策模型。
DECISION_MODEL=qwen-chat
# 只適用於支援 enable_thinking 的模型。
LLM_DISABLE_THINKING=true

# 自動啟動設定。請依電腦調整執行檔路徑，手動啟動時註解掉 LLAMA_SERVER_EXE。
LLAMA_SERVER_EXE=D:/software/llama-cuda/llama-server.exe
# 每個選項和值各用一個 JSON 字串。Host、port 和 alias 由上方設定帶入。
LLAMA_SERVER_ARGS=["-hf","mradermacher/Huihui-Qwen3.5-9B-abliterated-GGUF:Q4_K_M","-ngl","auto","--fit","on","-c","16384","-fa","on","-ctk","q8_0","-ctv","q8_0","-b","1024","-ub","256","-np","1","--jinja","--no-mmproj"]
