# ── Discord ──
# 從 Discord Developer Portal 取得;記得開啟 Message Content Intent
DISCORD_TOKEN=your-discord-bot-token

# ── DeepSeek（本機 llama.cpp 請另用 llm.local.env.example）──
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# LLM 決策模型預設與 DEEPSEEK_MODEL 相同
# DECISION_MODEL=deepseek-chat
# 回覆生成的溫度，偏高讓語氣更口語、有變化
LLM_TEMPERATURE=1.1

# ── 角色 ──
# 對應 personas/<PERSONA>.toml
PERSONA=syrup

# ── 回覆行為 ──
# 決策策略：heuristic（機率規則，免費快速）或 llm（讓模型讀上下文判斷氣氛）
DECISION_STRATEGY=heuristic
# heuristic 策略下，一般訊息的基礎插話機率（0~1）
REPLY_PROBABILITY=0.08
# 同一成員連發訊息的收集窗口（秒），0 可關閉合併
TURN_WINDOW_SECONDS=0.8
# 同頻道兩次主動回覆的最短間隔（秒），避免洗版
REPLY_COOLDOWN_SECONDS=20
# llm 策略下，每頻道觸發一次 LLM 判斷的最短間隔（秒），控制 API 成本
DECISION_COOLDOWN_SECONDS=10
# 餵給 LLM 的近期訊息數
MAX_CONTEXT_MESSAGES=20
# 留空＝所有它看得到的頻道都會互動；或填逗號分隔的頻道 ID 來限制（這是「初始值」，
# 管理員之後可用 /set 即時調整，調整結果存在 CHANNEL_POLICY_PATH 並覆蓋這裡）
ALLOWED_CHANNEL_IDS=
# 管理員用斜線指令調整頻道後，設定存到這個檔（重啟不忘）
CHANNEL_POLICY_PATH=data/channels.json

# ── 表情符號回應 ──
# 總開關：true 開、false 關
REACTIONS_ENABLED=true
# 看到一則訊息時，自己貼表情的機率（0~1）。表情對應表在 personas/<PERSONA>.toml 的 [reactions]
SELF_REACTION_PROBABILITY=0.2
# 別人按了某個表情時，跟著按同一個的機率（0~1）
FOLLOW_REACTION_PROBABILITY=0.5
# 至少要有幾個人按過同一個表情，她才會跟著按（1＝有人按就可能跟）
FOLLOW_REACTION_MIN_COUNT=2

# ── GIF ──
# 動圖清單及關鍵字在 personas/<PERSONA>.toml 的 [gifs]。
GIFS_ENABLED=true
# 命中個別動圖的關鍵字時，自動發一張的機率。
GIF_REPLY_PROBABILITY=0.12
# 同一頻道兩次自動發 GIF 的最短間隔。
GIF_COOLDOWN_SECONDS=90

# ── 其他 ──
LOG_LEVEL=INFO
